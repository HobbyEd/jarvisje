# Copy to `.env` and fill in real values. Never commit `.env` (see ADR-011).
#
#   cp .env.example .env
#

# --- Indexering (UI / HTTP API) ---
# Generate a long random string; rotate if it ever leaked into git or logs.
INGEST_TOKEN=
# Alias accepted by the app (same meaning as INGEST_TOKEN):
# INDEX_TOKEN=

# --- Productiehost (SSH + paden) ---
# Linux-user op de app-host (niet de publieke blogdomeinen).
DEPLOY_USER=
# LAN-IP of hostname van de app-host (niet in git).
DEPLOY_HOST=
# Optioneel; default is DEPLOY_USER@DEPLOY_HOST
# DEPLOY_SSH=
# Home van DEPLOY_USER op de host — compose volumes + systemd WorkingDirectory.
# Voorbeeld: /home/<user>
HOST_HOME=

# --- Optionele LLM-overrides (lokaal) ---
# Productie-compose zet LLM_BASE_URL=http://ollama:11434/v1
# Lokaal tegen Ollama op de host:
# LLM_BASE_URL=http://<DEPLOY_HOST>:11434/v1
# LLM_MODEL=gemma3:4b
# EMBEDDING_DEVICE=cpu
# API_BASE_URL=http://<DEPLOY_HOST>:8080
